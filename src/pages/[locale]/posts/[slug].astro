---
import { getEmDashEntry, getEmDashCollection, getEntryTerms } from "emdash";
import { Image, PortableText, Comments, CommentForm, WidgetArea } from "emdash/ui";
import Base from "../../../layouts/Base.astro";
import PostCard from "../../../components/PostCard.astro";
import { getReadingTime } from "../../../utils/reading-time";

const { locale, slug } = Astro.params;

if (!locale || !slug) return Astro.redirect("/404");

const { entry: post, cacheHint } = await getEmDashEntry("posts", slug, { locale });

if (!post) return Astro.redirect("/404");

Astro.cache.set(cacheHint);

const tags = await getEntryTerms("posts", post.data.id, "tag");
const bylines = post.data.bylines ?? [];
const readingTime = getReadingTime(post.data.content);

const { entries: recentPosts } = await getEmDashCollection("posts", {
	orderBy: { published_at: "desc" },
	limit: 4,
	locale,
});
const otherPosts = recentPosts.filter((p) => p.id !== post.id).slice(0, 3);

const publishDate =
	post.data.publishedAt?.toLocaleDateString("en-US", {
		year: "numeric",
		month: "long",
		day: "numeric",
	}) ?? null;
---

<Base
	title={post.data.title}
	content={{ collection: "posts", id: post.data.id, slug }}
>
	<article>
		{
			post.data.featured_image && (
				<div class="bg-body-secondary" {...post.edit.featured_image}>
					<div class="container py-0 px-0 px-md-3">
						<Image image={post.data.featured_image} class="w-100 article-hero-img" />
					</div>
				</div>
			)
		}

		<div class="container py-5">
			<div class="row justify-content-center g-5">
				<div class="col-lg-8 col-xl-7">
					<nav aria-label="breadcrumb" class="mb-4">
						<ol class="breadcrumb small">
							<li class="breadcrumb-item">
								<a href={`/${locale}`} class="text-secondary text-decoration-none">Home</a>
							</li>
							<li class="breadcrumb-item">
								<a href={`/${locale}/posts`} class="text-secondary text-decoration-none">Posts</a>
							</li>
							<li class="breadcrumb-item active text-truncate" style="max-width: 200px;">
								{post.data.title}
							</li>
						</ol>
					</nav>

					<header class="mb-4">
						<p class="small text-secondary mb-2">
							{publishDate && <time>{publishDate}</time>}
							{publishDate && <span aria-hidden="true"> &middot; </span>}
							<span>{readingTime} min read</span>
						</p>

						<h1 class="display-5 fw-bold lh-sm mb-3" {...post.edit.title}>
							{post.data.title}
						</h1>

						{post.data.excerpt && (
							<p class="lead text-secondary mb-3">{post.data.excerpt}</p>
						)}

						{tags.length > 0 && (
							<div class="d-flex flex-wrap gap-2">
								{tags.map((t) => (
									<a href={`/${locale}/tag/${t.slug}`} class="badge text-bg-secondary text-decoration-none fw-normal">
										{t.label}
									</a>
								))}
							</div>
						)}
					</header>

					<hr class="mb-4" />

					<div class="article-content">
						<PortableText value={post.data.content} />
					</div>

					<div class="comments-section mt-5 pt-4 border-top">
						<Comments collection="posts" contentId={post.data.id} threaded />
						<CommentForm collection="posts" contentId={post.data.id} />
					</div>
				</div>

				<aside class="col-lg-3 col-xl-3 d-none d-lg-block">
					<div class="sidebar-sticky">
						<div class="card border-0 bg-body-secondary mb-4">
							<div class="card-body">
								<h6 class="text-uppercase text-secondary fw-semibold mb-3" style="font-size: 0.7rem; letter-spacing: 0.07em;">
									On this page
								</h6>
								<div id="toc-content"></div>
							</div>
						</div>
						<div class="sidebar-widgets">
							<WidgetArea name="sidebar" />
						</div>
					</div>
				</aside>
			</div>
		</div>
	</article>

	{otherPosts.length > 0 && (
		<section class="bg-body-secondary border-top py-5">
			<div class="container">
				<h2 class="h4 fw-bold mb-4">Continue reading</h2>
				<div class="row g-4">
					{otherPosts.map((p) => (
						<div class="col-sm-6 col-lg-4">
							<PostCard
								title={p.data.title}
								excerpt={p.data.excerpt}
								featuredImage={p.data.featured_image}
								href={`/${locale}/posts/${p.data.slug ?? p.id}`}
								date={p.data.publishedAt ?? undefined}
								readingTime={getReadingTime(p.data.content)}
								tags={[]}
								bylines={p.data.bylines ?? []}
							/>
						</div>
					))}
				</div>
			</div>
		</section>
	)}
</Base>

<style>
	.article-hero-img { max-height: 480px; object-fit: cover; }
	.sidebar-sticky { position: sticky; top: 80px; }
</style>

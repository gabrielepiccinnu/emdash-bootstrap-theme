---
import { getTerm, getEmDashCollection } from "emdash";
import Base from "../../../layouts/Base.astro";
import PostCard from "../../../components/PostCard.astro";
import { getReadingTime } from "../../../utils/reading-time";

const { locale, slug } = Astro.params;
const term = slug ? await getTerm("category", slug) : null;

if (!term) return Astro.redirect("/404");

const { entries: posts } = await getEmDashCollection("posts", {
	where: { category: term.slug },
	orderBy: { published_at: "desc" },
	locale,
});
---

<Base title={`Category: ${term.label}`} description={`All posts in ${term.label}`}>
	<div class="container py-5">
		<header class="border-bottom pb-4 mb-5">
			<p class="text-primary small text-uppercase fw-semibold mb-1" style="letter-spacing: 0.07em;">Category</p>
			<h1 class="fw-bold mb-1">{term.label}</h1>
			<p class="text-secondary small mb-0">{posts.length} {posts.length === 1 ? "post" : "posts"}</p>
		</header>

		{posts.length === 0 ? (
			<p class="text-secondary">No posts in this category yet.</p>
		) : (
			<div class="row g-4">
				{posts.map((post) => (
					<div class="col-sm-6 col-lg-4">
						<PostCard
							title={post.data.title}
							excerpt={post.data.excerpt}
							featuredImage={post.data.featured_image}
							href={`/${locale}/posts/${post.data.slug ?? post.id}`}
							date={post.data.publishedAt ?? undefined}
							readingTime={getReadingTime(post.data.content)}
							tags={[]}
							bylines={post.data.bylines ?? []}
						/>
					</div>
				))}
			</div>
		)}
	</div>
</Base>

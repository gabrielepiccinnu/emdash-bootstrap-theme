---
// Root redirect — forward to the default locale.
// The plugin manages which locale is default; here we read it via the plugin API.
// Fallback: "en" if the plugin isn't configured yet.
let defaultLocale = "en";

try {
	const apiUrl = `${Astro.url.origin}/_emdash/api/plugins/emdash-multilanguage/languages/list`;
	const res = await fetch(apiUrl, {
		method: "POST",
		headers: {
			"content-type": "application/json",
			cookie: Astro.request.headers.get("cookie") ?? "",
		},
		body: JSON.stringify({}),
	});
	if (res.ok) {
		const body = (await res.json()) as { data?: { languages?: Array<{ code: string; isDefault: boolean }> } };
		const def = body.data?.languages?.find((l) => l.isDefault);
		if (def) defaultLocale = def.code;
	}
} catch {
	// Ignore — use fallback
}

return Astro.redirect(`/${defaultLocale}`, 302);
---

---
import type { MediaValue, ContentBylineCredit } from "emdash";
import { Image } from "emdash/ui";

interface Props {
	title: string;
	excerpt?: string;
	featuredImage?: MediaValue | string;
	href: string;
	date?: Date;
	readingTime?: number;
	tags?: Array<{ slug: string; label: string }>;
	bylines?: ContentBylineCredit[];
	locale?: string;
}

const {
	title,
	excerpt,
	featuredImage,
	href,
	date,
	readingTime,
	tags,
	bylines,
} = Astro.props;

const locale: string = Astro.props.locale ?? (Astro.params.locale as string | undefined) ?? "en";

const formattedDate = date
	? date.toLocaleDateString("en-US", {
			year: "numeric",
			month: "short",
			day: "numeric",
		})
	: null;
---

<div class="card h-100 border shadow-sm">
	<a href={href} class="text-decoration-none" tabindex="-1" aria-hidden="true">
		{
			featuredImage ? (
				<div class="overflow-hidden" style="border-radius: var(--bs-card-border-radius) var(--bs-card-border-radius) 0 0;">
					<Image image={featuredImage} class="post-card-img card-img-top" />
				</div>
			) : (
				<div
					class="bg-secondary-subtle"
					style="aspect-ratio: 16/10; border-radius: var(--bs-card-border-radius) var(--bs-card-border-radius) 0 0;"
				/>
			)
		}
	</a>

	<div class="card-body d-flex flex-column">
		<!-- Meta: bylines · date · reading time -->
		<p class="card-text small text-secondary mb-2 d-flex align-items-center flex-wrap gap-1">
			{
				bylines && bylines.length > 0 && (
					<>
						<span class="d-inline-flex align-items-center gap-1">
							{bylines.slice(0, 1).map((credit) => (
								<>
									{credit.byline.avatarMediaId && (
										<img
											src={`/_emdash/api/media/file/${credit.byline.avatarMediaId}`}
											alt={credit.byline.displayName}
											width="18"
											height="18"
											class="rounded-circle object-fit-cover"
										/>
									)}
									<span class="fw-medium text-body-secondary">
										{credit.byline.displayName}
									</span>
								</>
							))}
							{bylines.length > 1 && (
								<span
									title={bylines
										.slice(1)
										.map((c) => c.byline.displayName)
										.join(", ")}
								>
									+{bylines.length - 1}
								</span>
							)}
						</span>
						<span aria-hidden="true">&middot;</span>
					</>
				)
			}
			{formattedDate && <time>{formattedDate}</time>}
			{formattedDate && readingTime && <span aria-hidden="true">&middot;</span>}
			{readingTime && <span>{readingTime} min</span>}
		</p>

		<!-- Title -->
		<h5 class="card-title mb-2">
			<a href={href} class="text-body text-decoration-none stretched-link card-title-link">
				{title}
			</a>
		</h5>

		<!-- Excerpt -->
		{
			excerpt && (
				<p class="card-text text-secondary small mb-0 post-card-excerpt">{excerpt}</p>
			)
		}
	</div>

	<!-- Tags as badges — outside card-body so stretched-link doesn't block clicks -->
	{
		tags && tags.length > 0 && (
			<div class="card-footer bg-transparent border-0 pt-0 d-flex flex-wrap gap-1">
				{tags.slice(0, 3).map((tag) => (
					<a
						href={`/${locale}/tag/${tag.slug}`}
						class="badge text-bg-secondary text-decoration-none fw-normal"
						style="position: relative; z-index: 1;"
					>
						{tag.label}
					</a>
				))}
			</div>
		)
	}
</div>

<style>
	.card-title-link:hover {
		color: var(--bs-primary) !important;
	}

	.post-card-img {
		aspect-ratio: 16 / 10;
		object-fit: cover;
		width: 100%;
		transition: transform 0.3s ease;
	}

	.card:hover .post-card-img {
		transform: scale(1.03);
	}

	.post-card-excerpt {
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}
</style>
